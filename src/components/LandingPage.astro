---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '../styles/global.css';
import { copy, type Language } from '../data/copy';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = copy[lang];
const isChinese = lang === 'zh';
const base = 'https://fynxlab.com';
const canonical = isChinese ? `${base}/zh/` : `${base}/`;
const englishUrl = `${base}/`;
const chineseUrl = `${base}/zh/`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'fynxlab',
  url: base,
  email: 'admin@fynxlab.com',
};
---
<!doctype html>
<html lang={isChinese ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#091721" />
    <meta name="description" content={t.seo.description} />
    <meta name="robots" content="index, follow" />
    <title>{t.seo.title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fynxlab" />
    <meta property="og:locale" content={t.seo.ogLocale} />
    <meta property="og:title" content={t.seo.title} />
    <meta property="og:description" content={t.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${base}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="fynxlab — software development studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.seo.title} />
    <meta name="twitter:description" content={t.seo.description} />
    <meta name="twitter:image" content={`${base}/og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body class:list={[{ 'is-zh': isChinese }]}>
    <div class="pointer-glow" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header" id="top">
      <div class="shell header-inner">
        <a class="wordmark" href={isChinese ? '/zh/' : '/'} aria-label={t.home}>
          <img src="/favicon.png" alt="" width="46" height="46" />
          <span class="brand-type"><span>fynx</span><span class="brand-dash">-</span>lab</span>
        </a>
        <nav class="nav" aria-label={t.navLabel}>
          <a href="#work">{t.nav.work}</a>
          <a href="#studio">{t.nav.studio}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>
        <nav class="language-switch" aria-label={t.languageLabel}>
          <a href="/" lang="en" aria-current={!isChinese ? 'page' : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href="/zh/" lang="zh-CN" aria-current={isChinese ? 'page' : undefined}>中文</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-topline"><span class="eyebrow"><span class="signal" aria-hidden="true"></span>{t.hero.kicker}</span><span class="hero-index">F / L &nbsp;·&nbsp; SPEC. 001</span></div>
        <div class="hero-grid">
          <div>
            <h1 id="hero-title"><span>{t.hero.first}</span><br /><em>{t.hero.second}</em></h1>
            <p class="hero-footnote">{t.hero.footnote}</p>
          </div>
          <div class="hero-aside">
            <div class="identity-plate" aria-hidden="true">
              <div class="identity-plate-top"><span>FIG. 00 — FYNXLAB</span><span>+</span></div>
              <img src="/images/fynxlab-logo.png" alt="" width="200" height="200" />
              <div class="identity-plate-bottom"><span>BRAND IDENTITY</span><span>01 / 01</span></div>
            </div>
            <p>{t.hero.description}</p>
            <div class="hero-actions">
              <a class="text-link" href="#work">{t.hero.work}<span class="arrow" aria-hidden="true">↗</span></a>
              <a class="muted-link" href="#contact">{t.hero.contact}</a>
            </div>
          </div>
        </div>
        <div class="hero-bottom"><span>{t.hero.scroll}</span><span class="scroll-mark" aria-hidden="true">↓</span><span>© fynxlab</span></div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="shell section-intro">
          <span class="eyebrow section-label">{t.work.kicker}</span>
          <div class="section-intro-content"><h2 id="work-title">{t.work.title}</h2><p>{t.work.introduction}</p></div>
        </div>

        <article class="project shell" aria-labelledby="kyna-title">
          <div class="project-meta"><span>01 — 02</span><span>{t.work.kyna.category}</span></div>
          <a class="project-visual kyna-visual" href="https://kyna.fynxlab.com/" aria-label={t.work.kyna.link}>
            <div class="kyna-frame"><img src="/images/kyna-player.webp" alt={t.work.kyna.imageAlt} width="976" height="556" loading="lazy" decoding="async" /></div>
          </a>
          <div class="project-details"><div><h3 id="kyna-title">{t.work.kyna.name}</h3><p>{t.work.kyna.description}</p></div><a class="round-link" href="https://kyna.fynxlab.com/" aria-label={t.work.kyna.link}><span aria-hidden="true">↗</span></a></div>
        </article>

        <article class="project shell" aria-labelledby="pin-title">
          <div class="project-meta"><span>02 — 02</span><span>{t.work.pin.category}</span></div>
          <a class="project-visual pin-visual" href="https://pinlaunch.fynxlab.com/" aria-label={t.work.pin.link}>
            <img class="pin-screenshot" src="/images/pinlaunch-screenshot.png" alt={t.work.pin.imageAlt} width="506" height="429" loading="lazy" decoding="async" />
          </a>
          <div class="project-details"><div><h3 id="pin-title">{t.work.pin.name}</h3><p>{t.work.pin.description}</p></div><a class="round-link" href="https://pinlaunch.fynxlab.com/" aria-label={t.work.pin.link}><span aria-hidden="true">↗</span></a></div>
        </article>
      </section>

      <section class="studio-section" id="studio" aria-labelledby="studio-title">
        <div class="shell studio-grid">
          <span class="eyebrow section-label">{t.studio.kicker}</span>
          <div class="studio-content"><h2 id="studio-title">{t.studio.titleA}<br /><em>{t.studio.titleB}</em></h2><p>{t.studio.text}</p><div class="studio-service"><span class="eyebrow">{t.studio.serviceLabel}</span><p>{t.studio.service}</p></div></div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="shell">
          <span class="eyebrow">{t.contact.kicker}</span>
          <div class="contact-main"><h2 id="contact-title">{t.contact.titleA}<br /><em>{t.contact.titleB}</em></h2><div class="contact-aside"><p>{t.contact.text}</p><a class="contact-button" href="mailto:admin@fynxlab.com" aria-label={t.contact.emailLabel}>{t.contact.action}<span aria-hidden="true">↗</span></a></div></div>
          <a class="contact-email" href="mailto:admin@fynxlab.com">admin@fynxlab.com</a>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="shell footer-inner"><div><a class="footer-brand" href={isChinese ? '/zh/' : '/'}><img src="/favicon.png" alt="" width="32" height="32" /><span class="brand-type"><span>fynx</span><span class="brand-dash">-</span>lab</span></a><p>{t.footer.note}</p></div><div class="footer-right"><a href="#top">{t.footer.back} ↑</a><small>© {new Date().getFullYear()} fynxlab. {t.footer.rights}</small></div></div></footer>
    <script>
      const glow = document.querySelector<HTMLElement>('.pointer-glow');
      if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let frame = 0;
        let x = 0;
        let y = 0;
        window.addEventListener('pointermove', (event) => {
          x = event.clientX;
          y = event.clientY;
          glow.classList.add('is-active');
          if (frame) return;
          frame = requestAnimationFrame(() => {
            glow.style.setProperty('--pointer-x', `${x}px`);
            glow.style.setProperty('--pointer-y', `${y}px`);
            frame = 0;
          });
        }, { passive: true });
        const hideGlow = () => glow.classList.remove('is-active');
        document.addEventListener('pointerleave', hideGlow);
        window.addEventListener('blur', hideGlow);
      }
    </script>
  </body>
</html>
